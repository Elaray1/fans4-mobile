{
  "extends": [
    "@paralect/eslint-config",
    "plugin:react-hooks/recommended"
  ],
  "rules": {
    "class-methods-use-this": "off",
    "object-curly-newline": "off",
    "react/jsx-one-expression-per-line": "off",
    "max-len": ["error", {
      "code": 120
    }],
    "consistent-return": "off",
    "no-console": "off",
    "no-param-reassign": "off",
    "import/extensions": [
      2,
      {
        "json": "never",
        "jsx": "never",
        "js": "never",
        "svg": "always"
      }
    ]
  }
}
