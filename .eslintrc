{
  "extends": [
    "@paralect/eslint-config",
    "plugin:react-hooks/recommended"
  ],
  "rules": {
    "consistent-return": "off",
    "no-console": "off",
    "import/extensions": [
      2,
      {
        "json": "never",
        "jsx": "never",
        "js": "never",
        "svg": "always"
      }
    ]
  }
}
